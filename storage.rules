rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /capas/{userId}/{fileName} {
   allow read: if true;
   allow write: if request.auth != null && request.auth.uid == 'SUBSTITUIR_UID' && userId == request.auth.uid && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
  }
 }
}
